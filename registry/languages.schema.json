{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/the-tower-of-babel/registry/languages.schema.json",
  "title": "Tower of Babel canonical language manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "policies",
    "languages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "repository",
        "canonical_source",
        "generated_artifacts"
      ]
    },
    "policies": {
      "type": "object"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "extension",
          "category",
          "primary_domain",
          "w4h",
          "examples",
          "build",
          "interfaces",
          "maturity",
          "links",
          "smithery",
          "spiral_engine"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "extension": {
            "type": "string",
            "pattern": "^\\."
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "primary_domain": {
            "type": "string",
            "minLength": 1
          },
          "w4h": {
            "type": "object",
            "required": [
              "what",
              "where",
              "when",
              "why",
              "how"
            ]
          },
          "examples": {
            "type": "object",
            "required": [
              "easy",
              "advanced"
            ]
          },
          "build": {
            "type": "object",
            "required": [
              "toolchain",
              "check",
              "run_easy",
              "run_advanced",
              "ci_tier"
            ]
          },
          "interfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "maturity": {
            "type": "object",
            "required": [
              "level",
              "status",
              "claim_scope",
              "promotion_gates"
            ]
          },
          "links": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "label",
                "url",
                "kind"
              ]
            }
          },
          "smithery": {
            "type": "object",
            "required": [
              "eligible",
              "role",
              "transports",
              "registration_status",
              "capability_namespace"
            ]
          },
          "spiral_engine": {
            "type": "object",
            "required": [
              "pillar",
              "piston",
              "capability_id",
              "registration_status",
              "evidence_required"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
